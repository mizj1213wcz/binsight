# Copy to .env and fill in what you need.

# Database (default: local SQLite file waste_management.db)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_waste_db

# Optional overflow-alert emails via EmailJS. Leave empty to only log alerts.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Same keys for the browser (frontend/.env)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Model and fleet settings (see config/city.py)
# HISTORY_DAYS=30
# FLEET_SIZE=24
# TRIPS_PER_TRUCK=3
# SOLVER_TIME_LIMIT_S=15
